{
  "mcpServers": {
    "chrome-devtools-mcp": {
      "command": "bunx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    },
    "exa": {
      "enabled": true,
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "better-t-stack": {
      "command": "bunx",
      "args": ["create-better-t-stack@latest", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.inkeep.com/better-auth/mcp"
    }
  }
}
